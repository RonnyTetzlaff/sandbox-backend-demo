# Vorlage fuer lokale Umgebungsvariablen: cp .env.example .env
# Bun laedt .env automatisch. Alle Werte sind optional, hier stehen die Defaults.

# Port des HTTP-Servers
PORT=3000

# Zeitserver fuer GET /time
NTP_SERVER=pool.ntp.org
# Wartezeit auf die NTP-Antwort in ms, danach antwortet /time mit 503
NTP_TIMEOUT_MS=3000
# Mindestabstand zweier NTP-Syncs in ms; 0 synchronisiert bei jedem Request
NTP_CACHE_MS=60000
